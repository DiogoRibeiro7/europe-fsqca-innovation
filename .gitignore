__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
dist/
build/
coverage.xml
.coverage
htmlcov/
.DS_Store

# WBES microdata may be access-controlled. Never commit raw or derived case-level data.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

results/*
!results/.gitkeep

# Generated diagnostics from the CLI (schema, mapping, readiness, harmonisation).
outputs/

# LaTeX build outputs
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.pdf
paper/*.synctex.gz

# renv keeps the lockfile and activation script under version control and the
# installed library out of it. Restore with renv::restore().
renv/library/
renv/staging/
renv/local/
renv/cellar/
renv/sandbox/
renv/python/
.rlib/
